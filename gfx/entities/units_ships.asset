entity = { 
	name = "battle_cruiser_entity"
	pdxmesh = "generic_submarine_mesh" 
	
	default_state = idle
	state = { name = "idle" 		animation = "idle" }
	state = { name = "walk" 		animation = "idle" }
	state = { name = "attack"		animation = "attack"}
	
	scale = 3.5
}



