#### Dams ########################################################

#Generic dam
entity = {
	name = "building_generic_dam"
	pdxmesh = "generic_dam_mesh"

	default_state = "idle"
	state = { name = "idle" 		animation = "idle" 			animation_blend_time = 0.0  animation_speed = 1.0 looping = no
			event = { time = 0 node="water" particle = "water_surface_effect_straight_particle"  keep_particle = yes trigger_once = yes }
			}


	scale = 0.7
}

entity = {
	clone = "building_generic_dam"
	name = "building_dam_spawn"
}

entity = {
	clone = "building_generic_dam"
	name = "building_dam"
}

#Generic dam DESTROYED
entity = {
	name = "building_generic_dam_destroyed"
	pdxmesh = "generic_dam_destroyed_mesh"

	default_state = "destroy"
	state = { name = "destroy" 		animation = "destroy" 			animation_blend_time = 0.0  animation_speed = 0.5 looping = no
			#event = { time = 0 node="water" particle = "water_surface_effect_particle"  keep_particle = yes  sound = { soundeffect = "water_burst" }}
			event = { time = 0 node="water" particle = "water_impact_small_particle"  keep_particle = yes sound = { soundeffect = "explosion_cement" }}	
			event = { time = 0.2 node="splash1" particle = "ship_fire_water_shockwave_particle"  keep_particle = yes sound = { soundeffect = "rock_impact" }}	
			event = { time = 0.2 node="splash1" particle = "water_impact_small_particle"  keep_particle = yes }	
			event = { time = 0.2 node="splash1" particle = "waterfall_particle"  keep_particle = yes trigger_once = yes }
			event = { time = 0.2 node="ground_splash1" particle = "waterfall_splash_particle"  keep_particle = yes trigger_once = yes sound = { soundeffect = "water_rush_large" }}	
			event = { time = 0.27 sound = { soundeffect = "explosion_large" }}	
			}


	scale = 0.7
}

entity = {
	clone = "building_generic_dam_destroyed"
	name = "building_dam_destroyed"
}


#### Mountain Dams ########################################################


#Generic mountain dam
entity = {
	name = "building_dam_mountain"
	pdxmesh = "generic_mountain_dam_mesh"

	default_state = "idle"
	state = { name = "idle" 		animation = "idle" 			animation_blend_time = 0.0  animation_speed = 1.0 looping = no
			event = { time = 0 node="water" particle = "water_surface_effect_particle"  keep_particle = yes trigger_once = yes }
			}


	scale = 0.7
}


#Generic mountain dam DESTROYED
entity = {
	name = "building_dam_mountain_destroyed"
	pdxmesh = "generic_mountain_dam_destroyed_mesh"

	default_state = "destroy"
	state = { name = "destroy" 		animation = "destroy" 			animation_blend_time = 0.0  animation_speed = 0.5 looping = no
			#event = { time = 0 node="water" particle = "water_surface_effect_particle"  keep_particle = yes  }
			event = { time = 0.2 node="water" particle = "water_impact_small_particle"  keep_particle = yes sound = { soundeffect = "explosion_large" }}	
			event = { time = 0 node="splash1" particle = "ship_explosion_particle"  keep_particle = yes sound = { soundeffect = "explosion_c4" }}	
			event = { time = 0 node="splash1" particle = "water_impact_small_particle"  keep_particle = yes }	
			event = { time = 0.5 node="splash1" particle = "waterfall_particle"  keep_particle = yes trigger_once = yes }
			event = { time = 0.6 node="ground_splash1" particle = "waterfall_splash_particle"  keep_particle = yes trigger_once = yes sound = { soundeffect = "water_rush_large" }}
			event = { time = 0.03 sound = { soundeffect = "explosion_cement" }}	
			event = { time = 0.2 sound = { soundeffect = "explosion_element" }}	
			event = { time = 0.2 sound = { soundeffect = "sub_hit_aggressive" }}	
			event = { time = 0.25 sound = { soundeffect = "rock_impact" }}	
			event = { time = 0.27 sound = { soundeffect = "water_burst" }}	
			}


	scale = 0.7
}

